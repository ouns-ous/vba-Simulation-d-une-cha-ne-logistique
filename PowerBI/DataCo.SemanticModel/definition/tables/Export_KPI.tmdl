	partition Export_KPI = m
		mode: import
		source =
				let
				    CsvPath = FolderExports & "/Export_KPI.csv",
				    CsvSource = Csv.Document(File.Contents(CsvPath), [Delimiter=",", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(CsvSource, [PromoteAllScalars=true]),
				    ValidRows = Table.SelectRows(Headers, each [CodeScenario] <> null and [CodeScenario] <> ""),
				    EmptyToNull = Table.ReplaceValue(ValidRows, "", null, Replacer.ReplaceValue, Table.ColumnNames(ValidRows)),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"CodeScenario", Int64.Type}, {"Run", Int64.Type}, {"CoutTotal", type number}, {"TauxService", type number}, {"TauxRupture", type number}, {"NbCommandes", Int64.Type}, {"StockMoyen", type number}, {"UnitesManquantes", Int64.Type}, {"TauxDispo", type number}, {"JoursRupture", Int64.Type}, {"RuptureMax", Int64.Type}, {"CoutPossession", type number}, {"CoutCommande", type number}, {"CoutRupture", type number}, {"Couverture", type number}}, "en-US")
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

