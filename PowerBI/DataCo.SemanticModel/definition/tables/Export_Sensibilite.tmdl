	partition Export_Sensibilite = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderExports & "/Export_Sensibilite.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    NonEmpty = Table.SelectRows(Headers, each Record.Field(_, "CodeScenario") <> "" and Record.Field(_, "CodeScenario") <> null),
				    Nulls = Table.ReplaceValue(NonEmpty, "", null, Replacer.ReplaceValue, Table.ColumnNames(NonEmpty)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"CodeScenario", Int64.Type}, {"Run", Int64.Type}, {"CommandesMultiples", type text}, {"CoutTotal", type number}, {"TauxService", type number}, {"TauxRupture", type number}, {"NbCommandes", Int64.Type}, {"StockMoyen", type number}, {"UnitesRupture", Int64.Type}}, "en-US")
				in Typed

