	partition Export_Stats = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderExports & "/Export_Stats.csv"), [Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    NonEmpty = Table.SelectRows(Headers, each Record.Field(_, "CodeScenario") <> "" and Record.Field(_, "CodeScenario") <> null),
				    Nulls = Table.ReplaceValue(NonEmpty, "", null, Replacer.ReplaceValue, Table.ColumnNames(NonEmpty)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"CodeScenario", Int64.Type}, {"CoutMoyen", type number}, {"CoutEcartType", type number}, {"CoutICBas", type number}, {"CoutICHaut", type number}, {"ServiceMoyen", type number}, {"ServiceEcartType", type number}, {"ServiceICBas", type number}, {"ServiceICHaut", type number}, {"RupturesMoyennes", type number}, {"CommandesMoyennes", type number}, {"StockMoyen", type number}}, "en-US")
				in Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

