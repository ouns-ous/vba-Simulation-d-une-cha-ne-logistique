	partition Scenarios = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderExports & "/Scenarios.csv"), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    NonEmpty = Table.SelectRows(Headers, each Record.Field(_, "CodeScenario") <> "" and Record.Field(_, "CodeScenario") <> null),
				    Nulls = Table.ReplaceValue(NonEmpty, "", null, Replacer.ReplaceValue, Table.ColumnNames(NonEmpty)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"CodeScenario", Int64.Type}, {"Nom", type text}, {"S0", Int64.Type}, {"s", Int64.Type}, {"Q", Int64.Type}}, "en-US")
				in Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

