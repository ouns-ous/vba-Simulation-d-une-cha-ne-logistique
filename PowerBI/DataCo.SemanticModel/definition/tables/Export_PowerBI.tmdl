	partition Export_PowerBI = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderExports & "/Export_PowerBI.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    NonEmpty = Table.SelectRows(Headers, each Record.Field(_, "CodeScenario") <> "" and Record.Field(_, "CodeScenario") <> null),
				    Nulls = Table.ReplaceValue(NonEmpty, "", null, Replacer.ReplaceValue, Table.ColumnNames(NonEmpty)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"CodeScenario", Int64.Type}, {"Jour", Int64.Type}, {"Demande", Int64.Type}, {"StockFinJournee", Int64.Type}, {"Ventes", Int64.Type}, {"Rupture", Int64.Type}, {"CommandePassee", Int64.Type}}, "en-US")
				in Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

