	partition Export_Apparie = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(FolderExports & "/Export_Apparie.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    NonEmpty = Table.SelectRows(Headers, each Record.Field(_, "ScenarioA") <> "" and Record.Field(_, "ScenarioA") <> null),
				    Nulls = Table.ReplaceValue(NonEmpty, "", null, Replacer.ReplaceValue, Table.ColumnNames(NonEmpty)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"ScenarioA", Int64.Type}, {"ScenarioB", Int64.Type}, {"DifferenceMoyenne", type number}, {"EcartType", type number}, {"ICBas", type number}, {"ICHaut", type number}, {"Conclusion", type text}}, "en-US")
				in Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

